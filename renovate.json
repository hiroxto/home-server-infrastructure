{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hiroxto/renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/hiroxto/{/,}**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "minimumReleaseAge": null,
      "pinDigests": true
    }
  ]
}
